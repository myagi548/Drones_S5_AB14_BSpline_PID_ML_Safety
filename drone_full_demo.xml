
<mujoco model="autonomous_drone_full_demo">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.01" gravity="0 0 -9.81" integrator="RK4"/>

  <visual>
    <global offwidth="1400" offheight="900"/>
    <map znear="0.01"/>
  </visual>

  <worldbody>
    <light pos="4 -4 12" dir="0 0 -1"/>
    <light pos="8 4 8" dir="-1 0 -1"/>

    <geom name="floor" type="plane"
          pos="4 0 0" size="16 8 0.1"
          rgba="0.78 0.81 0.84 1"/>

    <geom name="obstacle_1" type="box"
          pos="2 0 1.25" size="0.38 0.65 1.25"
          rgba="0.85 0.18 0.15 1"/>

    <geom name="obstacle_2" type="box"
          pos="4.5 0.25 1.45" size="0.42 0.62 1.45"
          rgba="0.85 0.18 0.15 1"/>

    <geom name="obstacle_3" type="box"
          pos="7 -0.2 1.15" size="0.38 0.65 1.15"
          rgba="0.85 0.18 0.15 1"/>

    <site name="target_1" pos="3.2 0 3.2"
          size="0.16" rgba="1 0.75 0.05 1"/>

    <site name="target_2" pos="6 0 3.2"
          size="0.16" rgba="1 0.75 0.05 1"/>

    <site name="target_final" pos="9.5 0 1"
          size="0.20" rgba="0.10 0.85 0.25 1"/>

    <body name="drone" pos="0 0 0.35">
      <freejoint name="root"/>

      <inertial pos="0 0 0" mass="1.2"
                diaginertia="0.025 0.025 0.045"/>

      <geom name="drone_body" type="box"
            size="0.18 0.12 0.06"
            rgba="0.12 0.35 0.90 1"/>

      <geom name="arm_x" type="capsule"
            fromto="-0.35 0 0 0.35 0 0"
            size="0.025" rgba="0.08 0.08 0.08 1"/>

      <geom name="arm_y" type="capsule"
            fromto="0 -0.35 0 0 0.35 0"
            size="0.025" rgba="0.08 0.08 0.08 1"/>

      <site name="body_site" pos="0 0 0"
            size="0.035" rgba="0.1 0.35 0.9 1"/>
    </body>
  </worldbody>
</mujoco>
